# Web image nginx config — envsubst template (nginx:alpine auto-renders on start).
# BACKEND_URL must be set as an env var on the Railway web service (the api service's
# public URL, e.g. https://<api>.up.railway.app).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Static SPA — everything that isn't an API/webhook path.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API — proxied to the backend so cookies stay same-origin (no CORS needed).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_connect_timeout 25s;
        proxy_read_timeout 25s;
    }

    # Telegram webhook lives at the ROOT path (Telegram registers FRONTEND_URL + /webhook/tg).
    location = /webhook/tg {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}
