# Copy to deploy.env (gitignored) and fill in. Used by redeploy.bat:
#  - RAILWAY_TOKEN  Railway account/workspace token (also set on both services)
#  - FRONTEND_URL   web service public URL (must match its /__redeploy endpoint)
#  - BACKEND_URL    api service public URL (must match its /__redeploy endpoint)
RAILWAY_TOKEN=
FRONTEND_URL=https://seal.up.railway.app
BACKEND_URL=https://sealbackend.up.railway.app